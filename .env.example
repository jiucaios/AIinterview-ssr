# AI面试模块环境配置示例
# 复制此文件为 .env 并填写实际配置
# 注意：.env 文件包含敏感信息，不要上传到版本控制

# ============================================
# 千问（Dashscope）API配置
# ============================================
# 在阿里云百炼平台获取API密钥：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DashScope API基础URL
# 中国区API密钥使用: https://dashscope.aliyuncs.com
# 国际区API密钥使用: https://dashscope.cn-hangzhou.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ============================================
# 模型配置
# ============================================
# 对话/提问/回答意图判断模型 - 当前统一使用全模态实时模型
QWEN_MODEL=qwen3.5-omni-plus
QWEN_MODEL_BASE=qwen3.5-omni-plus
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_REALTIME_VOICE=Sunnybobi
# 实时语音WebSocket URL（注意：不需要在URL中添加model参数，模型名称通过代码中的model参数传递）
# 中国区API密钥使用: wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# 国际区API密钥使用: wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_ENABLE_THINKING=false
ANSWER_EVALUATION_ENABLED=false
JD_SUMMARY_ENABLED=false

# 千问嵌入模型（用于语义相似度判断）
QWEN_EMBEDDING_MODEL=text-embedding-v4

# ============================================
# 缓存配置
# ============================================
# 当前使用Django内置的LocMemCache，无需额外安装Redis
# 如果需要使用Redis，取消下方注释并安装Redis服务
# REDIS_URL=redis://localhost:6379/1

# ============================================
# 会话配置
# ============================================
# 会话超时时间（秒）- 默认120秒
SESSION_TIMEOUT=120

# ============================================
# HR auth
# ============================================
# Requests with EXTERNAL_AI_SESSION_TOKEN can access HR endpoints without username/password.
# Supported formats:
#   Authorization: Bearer your_external_ai_session_token
#   ?token=your_external_ai_session_token

# Browser login checks ai_admin_user / ai_hr_user.
# Initial admin account is created by migration:
#   username: admin
#   password: admin123456

# ============================================
# Feishu unified event callback
# ============================================
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DEFAULT_JOB_NAME=AI应用工程师
FEISHU_DEFAULT_JOB_DESCRIPTION=由飞书简历文件创建的面试任务
FEISHU_DEFAULT_JOB_LEVEL=中级
FEISHU_INTERVIEW_VALID_DAYS=3

# ============================================
# Django配置
# ============================================
# 调试模式 - 开发环境设为True，生产环境设为False
DEBUG=True

# 允许访问的主机（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# 数据库配置（可选）
# ============================================
# 默认使用SQLite，如需使用其他数据库请配置
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# ============================================
# 日志配置（可选）
# ============================================
# LOG_LEVEL=DEBUG
# LOG_FILE=./logs/ai_interview.log

# ============================================
# 部署说明
# ============================================
# 1. 复制此文件为 .env
# 2. 填写 DASHSCOPE_API_KEY
# 3. 安装依赖: pip install -r requirements.txt
# 4. 执行数据库迁移: python manage.py migrate
# 5. 启动服务: python manage.py runserver
