# AI面试模块环境配置示例
# 复制此文件为 .env 并填写实际配置
# 注意：.env 文件包含敏感信息，不要上传到版本控制

# ============================================
# 千问（Dashscope）API配置
# ============================================
# 在阿里云百炼平台获取API密钥：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ============================================
# 模型配置
# ============================================
# 对话生成模型 - 当前使用 qwen-plus
# 可选值: qwen-plus, qwen-2, deepseek-v4-flash
QWEN_MODEL=qwen-plus
QWEN_ENABLE_THINKING=false
ANSWER_EVALUATION_ENABLED=false
JD_SUMMARY_ENABLED=false

# 千问嵌入模型（用于语义相似度判断）
QWEN_EMBEDDING_MODEL=text-embedding-v4

# ============================================
# 缓存配置
# ============================================
# 当前使用Django内置的LocMemCache，无需额外安装Redis
# 如果需要使用Redis，取消下方注释并安装Redis服务
# REDIS_URL=redis://localhost:6379/1

# ============================================
# 会话配置
# ============================================
# 会话超时时间（秒）- 默认120秒
SESSION_TIMEOUT=120

# ============================================
# Django配置
# ============================================
# 调试模式 - 开发环境设为True，生产环境设为False
DEBUG=True

# 允许访问的主机（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# 数据库配置（可选）
# ============================================
# 默认使用SQLite，如需使用其他数据库请配置
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# ============================================
# 日志配置（可选）
# ============================================
# LOG_LEVEL=DEBUG
# LOG_FILE=./logs/ai_interview.log

# ============================================
# 部署说明
# ============================================
# 1. 复制此文件为 .env
# 2. 填写 DASHSCOPE_API_KEY
# 3. 安装依赖: pip install -r requirements.txt
# 4. 执行数据库迁移: python manage.py migrate
# 5. 启动服务: python manage.py runserver
